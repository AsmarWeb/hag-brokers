{
  "openapi": "3.1.0",
  "info": {
    "title": "HAG Brokers Mobile & Integration API",
    "version": "1.0.0",
    "description": "Foundation release: authentication and public marketplace reads. Publishing, RFQ, chat, payments and partner credentials are not yet API features. JSON request/response; UTC ISO 8601 timestamps; decimal money strings. Errors follow Laravel message/errors format. 120 requests/min/IP overall; login/register/reset 5/min/IP each, forgot/resend 3/min/IP each. Store Bearer secrets in OS secure storage. Render user content as text. Native bearer authentication only; cookie sessions are insufficient."
  },
  "servers": [
    {
      "url": "https://hagbrokers.net/api/v1"
    },
    {
      "url": "http://localhost:8080/api/v1"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register individual or company",
        "security": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Token"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bearer token missing or expired"
          },
          "403": {
            "description": "Forbidden or invalid signature"
          },
          "404": {
            "description": "Unavailable resource"
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit; respect Retry-After"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_type": {
                    "type": "string",
                    "enum": [
                      "individual",
                      "company"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128,
                    "writeOnly": true
                  },
                  "password_confirmation": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128,
                    "writeOnly": true
                  },
                  "device_name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "company_name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 50
                  },
                  "country_code": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{2}$"
                  },
                  "city": {
                    "type": "string",
                    "maxLength": 255
                  }
                },
                "required": [
                  "account_type",
                  "name",
                  "email",
                  "password",
                  "password_confirmation",
                  "device_name"
                ]
              }
            }
          }
        },
        "description": "Company registration additionally requires company_name, phone, country_code. Creates a free workspace atomically. Individuals cannot publish as companies. Privileged identity fields are rejected. No payment is created.",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ]
            }
          }
        ]
      }
    },
