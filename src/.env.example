APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Company subscriptions: test mode only. Keep secrets local.
PLATFORM_BILLING_TEST_ENABLED=false
PLATFORM_STRIPE_TEST_SECRET=
PLATFORM_STRIPE_TEST_WEBHOOK_SECRET=
PLATFORM_STRIPE_TEST_PRICE_BUSINESS=
PLATFORM_STRIPE_TEST_PRICE_PROFESSIONAL=
PLATFORM_STRIPE_TEST_PORTAL_CONFIGURATION=

# Optional listing editor. Disabled until a server-side key is configured.
OPPORTUNITY_AI_ENABLED=false
OPPORTUNITY_OPENAI_API_KEY=
OPPORTUNITY_OPENAI_MODEL=gpt-5-mini
OPPORTUNITY_AI_COMPANY_DAILY_LIMIT=10
OPPORTUNITY_AI_PLATFORM_DAILY_LIMIT=100

# Public SEO: keep disabled on local/staging; enable on the public production site.
SEO_INDEXING_ENABLED=false
SEO_CANONICAL_URL=
SEO_SOCIAL_IMAGE=
SEO_GOOGLE_SITE_VERIFICATION=
SEO_BING_SITE_VERIFICATION=

# Company transaction alerts: disabled until SMTP and workers are configured.
COMPANY_MAIL_ENABLED=false
COMPANY_MAIL_MAILER=smtp

# Live subscription billing: opt in explicitly only after production checks.
PLATFORM_BILLING_MODE=test
PLATFORM_BILLING_LIVE_ENABLED=false
PLATFORM_BILLING_LIVE_CHECKOUT_ENABLED=false
PLATFORM_STRIPE_LIVE_SECRET=
PLATFORM_STRIPE_LIVE_WEBHOOK_SECRET=
PLATFORM_STRIPE_LIVE_PRICE_BUSINESS=
PLATFORM_STRIPE_LIVE_PRICE_PROFESSIONAL=
PLATFORM_STRIPE_LIVE_PORTAL_CONFIGURATION=
PLATFORM_BILLING_STRICT_PROOF_TEST_ENABLED=false

# Initial public launch: free plan; paid checkout stays closed.
PLATFORM_FREE_LAUNCH=true

# Expo server credentials only; never put access token in EXPO_PUBLIC variables.
MOBILE_PUSH_ENABLED=false
MOBILE_PUSH_PROJECT_ID=
MOBILE_PUSH_ACCESS_TOKEN=

# Gulf sailing catalogue. Optional nearby ports must also exist in the ports table.
FREIGHT_NEARBY_PORTS=
# Used by the read-only freight:searates-probe command.
SEARATES_SCHEDULES_API_KEY=

# Comma-separated disposable mailbox domains denied at registration and login.
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,guerrillamail.com,guerrillamailblock.com,sharklasers.com,yopmail.com,10minutemail.com,temp-mail.org,tempmail.com,getnada.com,maildrop.cc,dispostable.com,trashmail.com,emailondeck.com,mohmal.com,throwawaymail.com,fakeinbox.com,mintemail.com,mailcatch.com,inboxkitten.com,mailnesia.com,discard.email,spamgourmet.com,mytemp.email
